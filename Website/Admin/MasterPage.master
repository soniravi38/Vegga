<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="Software_MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title id="title" runat="server">Admin Panel</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <link rel="shortcut icon" type="image/x-icon" id="LogoIcon" runat="server" />
    <link href="../App_Content/StyleSheet.css" rel="stylesheet" />
    <link rel="stylesheet" href="../App_Content/Admin/bower_components/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="../App_Content/Admin/bower_components/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="../App_Content/Admin/bower_components/Ionicons/css/ionicons.min.css">
    <link rel="stylesheet" href="../App_Content/Admin/dist/css/AdminLTE.min.css">
    <link rel="stylesheet" href="../App_Content/Admin/dist/css/skins/_all-skins.min.css">
    <link rel="stylesheet" href="../App_Content/Admin/bower_components/morris.js/morris.css">
    <link rel="stylesheet" href="../App_Content/Admin/bower_components/jvectormap/jquery-jvectormap.css">
    <link rel="stylesheet" href="../App_Content/Admin/bower_components/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css">
    <link rel="stylesheet" href="../App_Content/Admin/bower_components/bootstrap-daterangepicker/daterangepicker.css">
    <link rel="stylesheet" href="../App_Content/Admin/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="hold-transition skin-blue sidebar-mini">
    <form runat="server">
        <asp:ScriptManager runat="server"></asp:ScriptManager>
        <div class="wrapper">
            <header class="main-header">
                <a href="index2.html" class="logo">
                    <span class="logo-mini"><asp:Image ID="imgCompanyShortLogo" onerror="this.src='../App_Content/icon/picture-not-available.jpg';" runat="server" Height="40px" alt="branding logo" /></span>
                    <span class="logo-lg">
                        <asp:Image ID="imgCompanyLogo" onerror="this.src='../App_Content/icon/picture-not-available.jpg';" runat="server" Height="40px" alt="branding logo" />
                    </span>
                </a>
                <nav class="navbar navbar-static-top">
                    <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
                        <span class="sr-only">Toggle navigation</span>
                    </a>
                    <div class="navbar-custom-menu">
                        <ul class="nav navbar-nav">
                            <li class="dropdown user user-menu">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                    <asp:Image ID="imgAdminPicture1" onerror="this.src='../App_Content/icon/index.png';" runat="server" CssClass="user-image" />
                                    <span class="hidden-xs">
                                        <asp:Label ID="lblAdminName1" runat="server" Text=""></asp:Label></span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li class="user-header">
                                        <asp:Image ID="imgAdminPicture2" onerror="this.src='../App_Content/icon/index.png';" runat="server" CssClass="user-image" />
                                        <p>
                                            <asp:Label ID="lblAdminName2" runat="server" Text=""></asp:Label>
                                            -
                                            <asp:Label ID="lblAdminDesignation" runat="server" Text=""></asp:Label>
                                        </p>
                                    </li>
                                    <li class="user-footer">
                                        <div class="pull-left">
                                            <asp:LinkButton ID="lnkbtnProfile" OnClick="lnkbtnProfile_Click" CssClass="btn btn-default btn-flat" runat="server">Profile</asp:LinkButton>
                                        </div>
                                        <div class="pull-right">
                                            <asp:LinkButton ID="lnkbtnLogOut" OnClick="lnkbtnLogOut_Click" CssClass="btn btn-default btn-flat" runat="server">Log Out</asp:LinkButton>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>
            <aside class="main-sidebar">
                <section class="sidebar">
                    <div class="user-panel">
                        <div class="pull-left image">
                            <asp:Image ID="imgAdminPicture3" onerror="this.src='../App_Content/icon/index.png';" runat="server" Width="45px" Height="45px" CssClass="img-circle" />
                        </div>
                        <div class="pull-left info">
                            <p>
                                <asp:Label ID="lblAdminName3" runat="server" Text=""></asp:Label></p>
                            <a href="#"><i class="fa fa-circle text-success"></i>Online</a>
                        </div>
                    </div>
                    <div class="sidebar-form">
                        <div class="input-group">
                            <input type="text" name="q" class="form-control" placeholder="Search...">
                            <span class="input-group-btn">
                                <button type="submit" name="search" id="search-btn" class="btn btn-flat">
                                    <i class="fa fa-search"></i>
                                </button>
                            </span>
                        </div>
                    </div>
                    <ul class="sidebar-menu" data-widget="tree">
                        <li class="header">MAIN NAVIGATION</li>
                        <li>
                            <a href="Dashboard.aspx">
                                <i class="fa fa-dashboard"></i><span>Dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a href="CompanyMaster.aspx">
                                <i class="fa fa-building"></i><span>Company Masters</span>
                            </a>
                        </li>
                        <li>
                            <a href="ListUserMaster.aspx">
                                <i class="fa fa-users"></i><span>User Master</span>
                            </a>
                        </li>
                        <li>
                            <a href="ListQueries.aspx">
                                <i class="fa fa-envelope"></i><span>Manage Queries</span>
                            </a>
                        </li>
                         <li>
                            <a href="ListCustomers.aspx">
                                <i class="fa fa-envelope"></i><span>Manage Custmoers</span>
                            </a>
                        </li>
                        <li>
                            <a href="ListMainSlider.aspx">
                                <i class="fa fa-image"></i><span>Main Slider</span>
                            </a>
                        </li>
                        <li>
                            <a href="ListMainImages.aspx">
                                <i class="fa fa-camera-retro"></i><span>Main Images</span>
                            </a>
                        </li>
                         <li class="treeview">
                            <a href="#">
                                <i class="fa fa-paint-brush"></i><span>Product Masters</span>
                                <span class="pull-right-container">
                                    <i class="fa fa-angle-left pull-right"></i>
                                </span>
                            </a>
                            <ul class="treeview-menu">
                                <li class="active"><a href="ListProductMaster.aspx"><i class="fa fa-circle-o"></i>Product</a></li>
                                <li><a href="ListProductDescription.aspx"><i class="fa fa-circle-o"></i>Product Description</a></li>
                                <li><a href="ListProductPicture.aspx"><i class="fa fa-circle-o"></i>Product Pictures</a></li>
                            </ul>
                        </li>
                         <li>
                            <a href="ListBlogMaster.aspx">
                                <i class="fa fa-rss-square"></i><span>Blogs</span>
                            </a>
                        </li>
                         <li>
                            <a href="ListReviewMaster.aspx">
                                <i class="fa fa-comment"></i><span>Reviews</span>
                            </a>
                        </li>
                        <li>
                            <a href="ListRatingMaster.aspx">
                                <i class="fa fa-star-half-full"></i><span>Ratings</span>
                            </a>
                        </li>
                       
                         <li>
                            <a href="AboutUsMaster.aspx">
                                <i class="fa fa-product-hunt"></i><span>About Us Master</span>
                            </a>
                        </li>
                        <li>
                            <a href="ListTestingCertificates.aspx">
                                <i class="fa fa-certificate"></i><span>Testing Certificates</span>
                            </a>
                        </li>
                         <li>
                            <a href="ListPayments.aspx">
                                <i class="fa fa-rupee"></i><span> Payments List</span>
                            </a>
                        </li>
                          <li style="display:none">
                            <a href="ListMenuMaster.aspx">
                                <i class="fa fa-list-ol"></i><span>Menu Master</span>
                            </a>
                        </li>
                    </ul>
                </section>
            </aside>
            <div class="content-wrapper">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </div>
            <footer class="main-footer">

                <strong>
                    <asp:Label ID="lblFooter" runat="server" Text=""></asp:Label></strong>
            </footer>

            <div class="control-sidebar-bg"></div>
        </div>
    </form>
    <script src="../App_Content/Admin/bower_components/jquery/dist/jquery.min.js"></script>
    <script src="../App_Content/Admin/bower_components/jquery-ui/jquery-ui.min.js"></script>
    <script>
        $.widget.bridge('uibutton', $.ui.button);
    </script>
    <script src="../App_Content/Admin/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="../App_Content/Admin/bower_components/raphael/raphael.min.js"></script>
    <script src="../App_Content/Admin/bower_components/morris.js/morris.min.js"></script>
    <script src="../App_Content/Admin/bower_components/jquery-sparkline/dist/jquery.sparkline.min.js"></script>
    <script src="../App_Content/Admin/plugins/jvectormap/jquery-jvectormap-1.2.2.min.js"></script>
    <script src="../App_Content/Admin/plugins/jvectormap/jquery-jvectormap-world-mill-en.js"></script>
    <script src="../App_Content/Admin/bower_components/jquery-knob/dist/jquery.knob.min.js"></script>
    <script src="../App_Content/Admin/bower_components/moment/min/moment.min.js"></script>
    <script src="../App_Content/Admin/bower_components/bootstrap-daterangepicker/daterangepicker.js"></script>
    <script src="../App_Content/Admin/bower_components/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
    <script src="../App_Content/Admin/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js"></script>
    <script src="../App_Content/Admin/bower_components/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="../App_Content/Admin/bower_components/fastclick/lib/fastclick.js"></script>
    <script src="../App_Content/Admin/dist/js/adminlte.min.js"></script>
    <script src="../App_Content/Admin/dist/js/pages/dashboard.js"></script>
    <script src="../App_Content/Admin/dist/js/demo.js"></script>
</body>
</html>
