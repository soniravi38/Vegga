    public void FillCountryCode()
    {
        DataTable dt = new DataTable();
        dt = cls.select_data_dt("Exec Proc_CountryCode 'GetAll1','',''");
        ddlCountryCode.DataSource = dt;
        ddlCountryCode.DataValueField = "ID";
        ddlCountryCode.DataTextField = "CountryCode";
        ddlCountryCode.DataBind();
        ddlCountryCode1.DataSource = dt;
        ddlCountryCode1.DataValueField = "ID";
        ddlCountryCode1.DataTextField = "CountryCode";
        ddlCountryCode1.DataBind();

        
    }
    
     private void FillMainSlider()
     {
         dt = cls.select_data_dt("Exec Proc_MainSlider 'GetAll1','','','',''");
