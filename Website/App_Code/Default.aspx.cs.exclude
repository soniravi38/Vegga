     protected void btnOneWay_Click(object sender, EventArgs e)
     {
        dt = cls.select_data_dt("Proc_MobileSMS 'GetAll',''");
        string destinationaddr = dt.Rows[0]["Mobile"].ToString();
        dtAPI = cls.select_data_dt("Proc_SMSApi 'GetAll',''");
        string smsAPI = dtAPI.Rows[0]["Api"].ToString();
        string message = "Someone Search ONE WAY TAXI!" + Environment.NewLine + "PICKUP : " + txtOneSource.Text + Environment.NewLine + "DROP-OFF : " + txtOneDestination.Text + Environment.NewLine + "PICKUP-DATE : " + txtOnePickupDate.Text + Environment.NewLine + "MOBILE : " + Convert.ToString(ddlCountryCode.SelectedItem) + "" + txtOneMobile.Text + "";
        String message1 = HttpUtility.UrlEncode(message);
        using (var wb = new WebClient())
        {
            byte[] response = wb.UploadValues("https://api.textlocal.in/send/", new NameValueCollection()
                {
                {"apikey" , smsAPI},
                {"numbers" , destinationaddr},
                {"message" , message},
                {"sender" , "TXTLCL"}
                });
            string result = System.Text.Encoding.UTF8.GetString(response);
        }
         
         int intresult = 0;
         intresult = cls.insert_data("Proc_MainSearch 'Insert','','" + txtOneSource.Text + "','" + txtOneDestination.Text + "','" + txtOnePickupDate.Text + "','" + ddlCountryCode.SelectedItem.Text + "','" + txtOneMobile.Text + "'");
         if (intresult > 0)
         {

         int VehicleCount = 0;
         VehicleCount = cls.select_data_scalar_int("select count(*) from tblVehicle where IsDelete=0 and IsActive=1");
         int count = 0;
         count = cls.select_data_scalar_int("select count(*) from OneTripFare where [From]='"+txtOneSource.Text.ToString()+"'and [To]='"+txtOneDestination.Text.ToString()+"'");
         if(count>=VehicleCount)
         {
         System.Threading.Thread.Sleep(5000);
         Session["OneFrom"] = txtOneSource.Text.ToString();
         Session["OneTo"] = txtOneDestination.Text.ToString();
         Session["PickDate"] = txtOnePickupDate.Text.ToString();
         Session["oneMobile"] = txtOneMobile.Text.ToString();
         Response.Redirect("OneWayRoutes.aspx");
         }
         else
         {
         Response.Redirect("SpecialRoutes.aspx");
         }

         }
     }
