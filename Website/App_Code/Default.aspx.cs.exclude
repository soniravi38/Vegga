     protected void btnRoundWay_Click(object sender, EventArgs e)
     {
         dt = cls.select_data_dt("Proc_MobileSMS 'GetAll',''");
         string destinationaddr = dt.Rows[0]["Mobile"].ToString();
         dtAPI = cls.select_data_dt("Proc_SMSApi 'GetAll',''");
         string smsAPI = dtAPI.Rows[0]["Api"].ToString();
         string message = "Someone Search ROUND WAY TAXI!" + Environment.NewLine + "PICKUP : " + txtRoundSource.Text + Environment.NewLine + "DROP-OFF : " + txtRoundDestination.Text + Environment.NewLine + "PICKUP-DATE : " + txtRoundPickupDate.Text + Environment.NewLine + "RETURN-DATE : " + txtRoundReturnDate.Text + Environment.NewLine + "MOBILE : " + Convert.ToString(ddlCountryCode.SelectedItem) + "" + txtRoundMobile.Text + "";
         String message1 = HttpUtility.UrlEncode(message);
         using (var wb = new WebClient())
         {
             byte[] response = wb.UploadValues("https://api.textlocal.in/send/", new NameValueCollection()
                {
                {"apikey" , smsAPI},
                {"numbers" , destinationaddr},
                {"message" , message},
                {"sender" , "TXTLCL"}
                });
             string result = System.Text.Encoding.UTF8.GetString(response);
         }

         int intresult = 0;
         intresult = cls.insert_data("Proc_RoundMainSearch 'Insert','','" + txtRoundSource.Text + "','" + txtRoundDestination.Text + "','" + txtRoundPickupDate.Text + "','"+txtRoundReturnDate.Text+"','" + ddlCountryCode1.SelectedItem.Text + "','" + txtRoundMobile.Text + "'");
         if (intresult > 0)
         {
             int VehicleCount = 0;
             VehicleCount = cls.select_data_scalar_int("select count(*) from tblVehicle where IsDelete=0 and IsActive=1");
             int count = 0;
             count = cls.select_data_scalar_int("select count(*) from OneTripFare where [From]='" + txtRoundSource.Text.ToString() + "'and [To]='" + txtRoundDestination.Text.ToString() + "'");
             if (count >= VehicleCount)
             {
                 System.Threading.Thread.Sleep(5000);
                 Session["RoundFrom"] = txtRoundSource.Text.ToString();
                 Session["RoundTo"] = txtRoundDestination.Text.ToString();
                 Session["RoundPickDate"] = txtRoundPickupDate.Text.ToString();
                 Session["RoundReturnDate"] = txtRoundReturnDate.Text.ToString();
                 Response.Redirect("RoundWayRoutes.aspx");
             }
             else
             {
                 Response.Redirect("SpecialRoutes.aspx");
             }

         }
     }
     protected void btnPackage_Click(object sender, EventArgs e)
     {
         dt = cls.select_data_dt("Proc_MobileSMS 'GetAll',''");
         string destinationaddr = dt.Rows[0]["Mobile"].ToString();
         dtAPI = cls.select_data_dt("Proc_SMSApi 'GetAll',''");
         string smsAPI = dtAPI.Rows[0]["Api"].ToString();
         string message = "Someone Search PACKAGES!"+ Environment.NewLine+"NAME : " + txtPackageName.Text + Environment.NewLine + "EMAIL : " + txtPackageEmail.Text + Environment.NewLine + "MOBILE : " + txtPackageMobile.Text + Environment.NewLine + "PLACE : " + txtPackagePlace.Text + "";
         String message1 = HttpUtility.UrlEncode(message);
         using (var wb = new WebClient())
         {
             byte[] response = wb.UploadValues("https://api.textlocal.in/send/", new NameValueCollection()
                {
                {"apikey" , smsAPI},
                {"numbers" , destinationaddr},
                {"message" , message},
                {"sender" , "TXTLCL"}
                });
             string result = System.Text.Encoding.UTF8.GetString(response);
         }

         int intPackages;
         intPackages = cls.insert_data("Proc_PackageForm 'Insert','','" + txtPackageName.Text + "','" + txtPackageEmail.Text + "','" + txtPackageMobile.Text + "','" + txtPackagePlace.Text + "',''");
         if (intPackages > 0)
         {
             Response.Write("<script>alert('Your Form has been Submitted ! we will contact you soon')</script>");
             Clear();
         }
     }
