                                        <div id="messages_product_view"></div>

                                        <div class="fieldset" style="margin-top: -12px;">
                                            <ul class="form-list">
                                                <li class="fields">
                                                    <div class="field">
                                                        <div class="input-box">
                                                            <asp:TextBox ID="txtQueryName" autocomplete="off" CssClass="input-text required-entry validate-alpha" placeholder="Your Name" runat="server"></asp:TextBox>
                                                            <asp:RequiredFieldValidator ControlToValidate="txtQueryName" ID="rfvQueryName" runat="server"
                                                                Display="Dynamic" ErrorMessage="Please Enter Name !" SetFocusOnError="True"
                                                                ValidationGroup="query">
                                                                Please Enter Name
                                                            </asp:RequiredFieldValidator>
                                                        </div>
                                                    </div>
